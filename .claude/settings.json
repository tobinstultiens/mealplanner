{
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(git fetch *)",
      "Bash(git worktree *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr list*)",
      "Bash(gh pr close *)",
      "Bash(gh issue close *)",
      "Bash(gh issue view *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue list*)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(gh release view*)",
      "Bash(gh release list*)"
    ],
    "ask": [
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(gh release create *)",
      "Bash(gh release edit *)",
      "Bash(gh release upload *)",
      "Bash(gh release delete *)",
      "Bash(gh release delete-asset *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate-git-push.sh",
            "if": "Bash(*git*push*)",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate-pr-merge.sh",
            "if": "Bash(*gh pr merge*)",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate-pr-merge.sh",
            "if": "Bash(*gh workflow run*)",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
