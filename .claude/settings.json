{
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(git fetch *)",
      "Bash(git worktree *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git push -u origin issue-*)",
      "Bash(git push origin issue-*)",
      "Bash(git push --force-with-lease origin issue-*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr list*)",
      "Bash(gh issue view *)",
      "Bash(gh issue comment *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)"
    ],
    "ask": [
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(gh workflow run *)",
      "Bash(gh release *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate-pr-merge.sh",
            "if": "Bash(*gh pr merge*)",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
