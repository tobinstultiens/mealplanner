-- A recipe of one account, from any source. Rows synced from the account's cooking repo
-- are identified by sourcePath; contentHash tells the sync whether the file changed.
-- A cooking-site recipe is in the account's bank until the account adds it (addedAt): only added
-- recipes are "my recipes", and only those in the rotation are picked by the planner on its own.
-- An added one is taken (issue 340): the account's own copy, which the sync no longer changes or marks
-- removed; it keeps its sourcePath, so the sync knows the file is taken and does not offer it again.
CREATE TABLE recipe (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    userId INTEGER NOT NULL REFERENCES appUser(id) ON DELETE CASCADE,
    source TEXT NOT NULL,              -- COOKING_SITE | MANUAL | GENERATED
    sourcePath TEXT,                   -- path under content/ for COOKING_SITE rows
    contentHash TEXT,
    section TEXT NOT NULL,
    title TEXT NOT NULL,
    tagsJson TEXT NOT NULL,
    servings INTEGER,
    instructions TEXT NOT NULL,
    hasIngredientsBlock INTEGER NOT NULL,
    problemsJson TEXT NOT NULL,
    kind TEXT NOT NULL,                -- MEAL | COMPONENT. App-owned: set on insert, kept on sync.
    mealSlotsJson TEXT,                -- App-owned: slots this recipe suits; NULL means the section's default
    removedAt TEXT,                    -- set when the file disappears from the cooking repo
    rating INTEGER,                    -- App-owned: 1 to 5, NULL when not rated
    imageSourceHash TEXT,              -- SHA-256 of the picture file the page shows, as last read; NULL when none
    imageVersion TEXT,                 -- version of the web-sized copy kept for it; NULL when there is none
    addedAt TEXT,                      -- App-owned: when it became one of my recipes; NULL while only in the bank
    inRotation INTEGER NOT NULL DEFAULT 0,  -- App-owned: 1 when the planner may pick it on its own
    keepsDays INTEGER,                 -- App-owned: days it keeps once made in a normal box (issue 234); NULL: not prepped that way
    keepsVacuumDays INTEGER,           -- App-owned: days it keeps once made and vacuum sealed; NULL: not prepped that way
    standardMeal INTEGER NOT NULL DEFAULT 0, -- App-owned: 1 when it is a standard meal of my recipes (issue 265)
    editedAt TEXT,                     -- App-owned: when it was last saved in the app (issue 340); NULL: never
    -- App-owned: 1 for the foods planned in one slot of the plan (issue 358), made and deleted by the app with that slot. Never
    -- added, so in no list of mine and no rotation, and left out of the bank (selectBank); its lines are the foods.
    slotFoods INTEGER NOT NULL DEFAULT 0,
    UNIQUE (userId, sourcePath)
);

CREATE TABLE recipeIngredient (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    recipeId INTEGER NOT NULL REFERENCES recipe(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    amount REAL,
    unit TEXT,
    dimension TEXT,
    baseAmount REAL,
    item TEXT NOT NULL,
    groupName TEXT,
    -- The catalogue ingredient the line is, saved with it (issue 340); NULL: looked up by its text (ingredientAlias).
    ingredientId INTEGER REFERENCES ingredient(id) ON DELETE SET NULL
);

CREATE INDEX recipeIngredient_recipe ON recipeIngredient(recipeId, position);

CREATE INDEX recipeIngredient_ingredient ON recipeIngredient(ingredientId);

-- An optional topping of a recipe (issue 226): an ingredient of the account's catalogue and the grams one
-- meal usually gets of it. App-owned and kept apart from the recipe's lines, so a sync never changes it and
-- it is not in the recipe's nutrition, cost or shopping until a meal has it added (mealLine).
CREATE TABLE recipeTopping (
    userId INTEGER NOT NULL REFERENCES appUser(id) ON DELETE CASCADE,
    recipeId INTEGER NOT NULL REFERENCES recipe(id) ON DELETE CASCADE,
    ingredientId INTEGER NOT NULL REFERENCES ingredient(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    grams REAL NOT NULL,
    PRIMARY KEY (userId, recipeId, ingredientId)
);

CREATE INDEX recipeTopping_ingredient ON recipeTopping(ingredientId);

-- My recipes: those the account added, also one whose file has since left the cooking site.
selectMine:
SELECT * FROM recipe WHERE userId = ? AND addedAt IS NOT NULL ORDER BY title COLLATE NOCASE;

-- The bank: cooking-site recipes on the site now that the account has not added; never the foods of a slot (issue 358).
selectBank:
SELECT * FROM recipe WHERE userId = ? AND addedAt IS NULL AND removedAt IS NULL AND slotFoods = 0 ORDER BY title COLLATE NOCASE;

selectById:
SELECT * FROM recipe WHERE userId = ? AND id = ?;

selectSynced:
SELECT id, sourcePath, contentHash, removedAt, addedAt FROM recipe WHERE userId = ? AND source = 'COOKING_SITE';

insertRecipe:
INSERT INTO recipe (userId, source, sourcePath, contentHash, section, title, tagsJson, servings, instructions, hasIngredientsBlock, problemsJson, kind, addedAt, inRotation)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertId:
SELECT last_insert_rowid();

updateSynced:
UPDATE recipe
SET contentHash = ?, section = ?, title = ?, tagsJson = ?, servings = ?, instructions = ?,
    hasIngredientsBlock = ?, problemsJson = ?, removedAt = NULL
WHERE userId = ? AND id = ?;

-- A building block is no standard meal (issue 265): becoming one ends it, which a meal keeps through any other save.
updateSettings:
UPDATE recipe SET kind = :kind, mealSlotsJson = :mealSlotsJson, standardMeal = CASE WHEN :kind = 'MEAL' THEN standardMeal ELSE 0 END
WHERE userId = :userId AND id = :id;

setKeeps:
UPDATE recipe SET keepsDays = :keepsDays, keepsVacuumDays = :keepsVacuumDays WHERE userId = :userId AND id = :id;

-- One of mine saved in the app: made there, or taken from the cooking site (issue 340). Its lines are those it was
-- saved with, so a site recipe without an ingredients block has one from then on, and the site's problems are gone.
updateMine:
UPDATE recipe SET title = :title, tagsJson = :tagsJson, servings = :servings, instructions = :instructions,
    hasIngredientsBlock = 1, problemsJson = '[]', editedAt = :editedAt
WHERE userId = :userId AND id = :id AND addedAt IS NOT NULL;

deleteMine:
DELETE FROM recipe WHERE userId = ? AND id = ? AND addedAt IS NOT NULL;

-- Adding one that is added already keeps when it was first added.
addToMine:
UPDATE recipe SET addedAt = coalesce(addedAt, :addedAt), inRotation = :inRotation WHERE userId = :userId AND id = :id;

-- Back to the bank; rating, kind and slots stay for when it is added again. A bank recipe is in no rotation and no
-- standard meal (issue 265).
removeFromMine:
UPDATE recipe SET addedAt = NULL, inRotation = 0, standardMeal = 0 WHERE userId = ? AND id = ?;

setStandardMeal:
UPDATE recipe SET standardMeal = :standardMeal WHERE userId = :userId AND id = :id;

setInRotation:
UPDATE recipe SET inRotation = ? WHERE userId = ? AND id = ?;

setRating:
UPDATE recipe SET rating = ? WHERE userId = ? AND id = ?;

-- A removed recipe loses its picture with it; the sync deletes the copy.
markRemoved:
UPDATE recipe SET removedAt = ?, imageSourceHash = NULL, imageVersion = NULL WHERE userId = ? AND id = ?;

-- The account's bank recipes on the site now, with what the last sync made of their pictures. A taken recipe keeps the
-- picture it had (issue 340).
selectBankPictures:
SELECT id, sourcePath, imageSourceHash, imageVersion FROM recipe
WHERE userId = ? AND source = 'COOKING_SITE' AND addedAt IS NULL AND removedAt IS NULL;

-- The recipes of the account with a copy of a picture: the files to keep.
selectKeptPictures:
SELECT id FROM recipe WHERE userId = ? AND imageVersion IS NOT NULL;

setPicture:
UPDATE recipe SET imageSourceHash = ?, imageVersion = ? WHERE userId = ? AND id = ?;

clearBankPictures:
UPDATE recipe SET imageSourceHash = NULL, imageVersion = NULL WHERE userId = ? AND addedAt IS NULL;

selectIngredients:
SELECT * FROM recipeIngredient WHERE recipeId = ? ORDER BY position;

deleteIngredients:
DELETE FROM recipeIngredient WHERE recipeId = ?;

insertIngredient:
INSERT INTO recipeIngredient (recipeId, position, amount, unit, dimension, baseAmount, item, groupName, ingredientId)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectToppings:
SELECT ingredientId, grams FROM recipeTopping WHERE userId = :userId AND recipeId = :recipeId ORDER BY position;

deleteToppings:
DELETE FROM recipeTopping WHERE userId = :userId AND recipeId = :recipeId;

insertTopping:
INSERT INTO recipeTopping (userId, recipeId, ingredientId, position, grams) VALUES (?, ?, ?, ?, ?);

-- The recipe of the foods of one slot (issue 358): one serving, never added, so in no list and no rotation. Edited now, so
-- that the unit a food was picked in is the one its ingredient starts in next (Ingredient.sq, selectLinkedUnits).
insertSlotFoods:
INSERT INTO recipe (userId, source, section, title, tagsJson, servings, instructions, hasIngredientsBlock, problemsJson, kind, addedAt, inRotation, editedAt, slotFoods)
VALUES (:userId, 'MANUAL', 'own', :title, '[]', 1, '', 1, '[]', 'MEAL', NULL, 0, :editedAt, 1);

setSlotFoodsTitle:
UPDATE recipe SET title = :title, editedAt = :editedAt WHERE userId = :userId AND id = :id AND slotFoods = 1;

-- One food of a slot in another amount, unit or ingredient: the line [id] of the slot's recipe [recipeId].
updateSlotFood:
UPDATE recipeIngredient SET amount = :amount, unit = :unit, dimension = :dimension, baseAmount = :baseAmount, item = :item, ingredientId = :ingredientId
WHERE id = :id AND recipeId = (SELECT id FROM recipe WHERE userId = :userId AND id = :recipeId AND slotFoods = 1);

deleteSlotFood:
DELETE FROM recipeIngredient WHERE id = :id AND recipeId = (SELECT id FROM recipe WHERE userId = :userId AND id = :recipeId AND slotFoods = 1);

-- The recipes of slots' foods that no planned meal holds any more: the slot was removed or replaced, or lost its last food
-- (issue 358). Their lines go with them (recipeIngredient's ON DELETE CASCADE).
deleteUnusedSlotFoods:
DELETE FROM recipe WHERE userId = :userId AND slotFoods = 1
    AND id NOT IN (SELECT foodsId FROM planMeal WHERE userId = :userId AND foodsId IS NOT NULL)
    AND id NOT IN (SELECT recipeId FROM planMeal WHERE userId = :userId);
