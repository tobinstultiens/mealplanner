-- Food eaten outside the plan, with rough numbers.
CREATE TABLE foodLog (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    date TEXT NOT NULL,
    description TEXT NOT NULL,
    kcal REAL NOT NULL,
    proteinG REAL NOT NULL
);

CREATE INDEX foodLog_date ON foodLog(date);

-- One weighing per day.
CREATE TABLE weight (
    date TEXT PRIMARY KEY,
    kg REAL NOT NULL
);

selectLogForDate:
SELECT * FROM foodLog WHERE date = ? ORDER BY id;

insertLog:
INSERT INTO foodLog (date, description, kcal, proteinG) VALUES (?, ?, ?, ?);

lastLogId:
SELECT last_insert_rowid();

deleteLog:
DELETE FROM foodLog WHERE id = ?;

selectWeights:
SELECT * FROM weight ORDER BY date;

upsertWeight:
INSERT OR REPLACE INTO weight (date, kg) VALUES (?, ?);

deleteWeight:
DELETE FROM weight WHERE date = ?;
