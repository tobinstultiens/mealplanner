-- Items ticked off on a week's shopping list, and dismissed advice groups (ShoppingKey). A tick of a
-- row of what the week's meals need keeps what the row said then (name, grams, pieces), so that the
-- list can tell when the plan needs more since, or no longer needs it; all three are NULL for other
-- ticks and for ticks from before version 12.
CREATE TABLE shoppingCheck (
    userId INTEGER NOT NULL REFERENCES appUser(id) ON DELETE CASCADE,
    weekStart TEXT NOT NULL,
    itemKey TEXT NOT NULL,
    name TEXT,
    grams REAL,                        -- the weight the row said; its known part when not all of it could be weighed
    pieces REAL,
    PRIMARY KEY (userId, weekStart, itemKey)
);

selectChecks:
SELECT itemKey, name, grams, pieces FROM shoppingCheck WHERE userId = ? AND weekStart = ?;

-- Ticking a ticked item again keeps what its first tick said.
insertCheck:
INSERT OR IGNORE INTO shoppingCheck (userId, weekStart, itemKey, name, grams, pieces) VALUES (?, ?, ?, ?, ?, ?);

deleteCheck:
DELETE FROM shoppingCheck WHERE userId = ? AND weekStart = ? AND itemKey = ?;

-- The ticks of rows of a text no ingredient is linked to (keys t:<text>), in every week.
selectTextChecks:
SELECT weekStart, itemKey FROM shoppingCheck WHERE userId = ? AND itemKey LIKE 't:%';

-- A tick moved to another key of its week, with what it remembers; where that key has a tick already, both stay as they are.
moveCheck:
UPDATE OR IGNORE shoppingCheck SET itemKey = :to WHERE userId = :userId AND weekStart = :weekStart AND itemKey = :from;

-- Things the account put on its shopping list itself (coffee, toilet paper), apart from what the
-- recipes need. One is on the list of every week from fromWeek on until it is ticked off; ticked
-- off in a week it belongs to that week (boughtWeek) and is on no other list.
CREATE TABLE shoppingExtra (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    userId INTEGER NOT NULL REFERENCES appUser(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    fromWeek TEXT NOT NULL,            -- ISO date of the plan week it was added in
    boughtWeek TEXT                    -- ISO date of the plan week it was ticked off in; NULL while open
);

CREATE INDEX shoppingExtra_user ON shoppingExtra(userId, boughtWeek);

-- The own items on the list of the week starting :week: added then or before, and not ticked off in another week.
selectExtrasForWeek:
SELECT * FROM shoppingExtra
WHERE userId = :userId AND fromWeek <= :week AND (boughtWeek IS NULL OR boughtWeek = :week)
ORDER BY id;

selectExtra:
SELECT * FROM shoppingExtra WHERE userId = ? AND id = ?;

countOpenExtras:
SELECT count(*) FROM shoppingExtra WHERE userId = ? AND boughtWeek IS NULL;

insertExtra:
INSERT INTO shoppingExtra (userId, name, fromWeek) VALUES (?, ?, ?);

-- Ticks an own item off in :week, only if it is on that week's list.
tickExtra:
UPDATE shoppingExtra SET boughtWeek = :week
WHERE userId = :userId AND id = :id AND fromWeek <= :week AND (boughtWeek IS NULL OR boughtWeek = :week);

-- Un-ticks an own item ticked off in :week; one ticked in another week stays as it is.
untickExtra:
UPDATE shoppingExtra SET boughtWeek = NULL WHERE userId = :userId AND id = :id AND boughtWeek = :week;

deleteExtra:
DELETE FROM shoppingExtra WHERE userId = ? AND id = ?;
