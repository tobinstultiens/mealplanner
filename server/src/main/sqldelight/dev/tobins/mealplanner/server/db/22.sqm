-- Version 22 -> 23: the planning screen (issue 255). The dinners chosen for a week before they are put on days, and the
-- recipes hidden for a week, are rows of a table of their own; no table is rebuilt and no row is touched: no week has a
-- dinner chosen or a recipe hidden until the account plans one that way.

CREATE TABLE planPick (
    userId INTEGER NOT NULL REFERENCES appUser(id) ON DELETE CASCADE,
    weekStart TEXT NOT NULL,
    recipeId INTEGER NOT NULL REFERENCES recipe(id) ON DELETE CASCADE,
    refused INTEGER NOT NULL,
    position INTEGER NOT NULL,
    PRIMARY KEY (userId, weekStart, recipeId)
);

CREATE INDEX planPick_recipe ON planPick(recipeId);
