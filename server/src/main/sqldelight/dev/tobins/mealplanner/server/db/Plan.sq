-- One planned meal. Nutrition is a snapshot taken when the meal was planned.
CREATE TABLE planMeal (
    weekStart TEXT NOT NULL,           -- ISO date of the plan's first day
    day INTEGER NOT NULL,              -- 0-based offset from weekStart
    slot TEXT NOT NULL,                -- BREAKFAST | LUNCH | DINNER | SNACK
    recipeId INTEGER NOT NULL,
    title TEXT NOT NULL,
    portions REAL NOT NULL,
    kcal REAL NOT NULL,
    proteinG REAL NOT NULL,
    leftover INTEGER NOT NULL,
    locked INTEGER NOT NULL,
    status TEXT NOT NULL DEFAULT 'PLANNED',   -- PLANNED | EATEN | SKIPPED
    PRIMARY KEY (weekStart, day, slot)
);

selectWeek:
SELECT * FROM planMeal WHERE weekStart = ? ORDER BY day;

upsertMeal:
INSERT OR REPLACE INTO planMeal (weekStart, day, slot, recipeId, title, portions, kcal, proteinG, leftover, locked, status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Replanning leaves alone what is locked or already eaten or skipped.
deleteUnlocked:
DELETE FROM planMeal WHERE weekStart = ? AND locked = 0 AND status = 'PLANNED';

setStatus:
UPDATE planMeal SET status = ? WHERE weekStart = ? AND day = ? AND slot = ?;

deleteMeal:
DELETE FROM planMeal WHERE weekStart = ? AND day = ? AND slot = ?;

setLocked:
UPDATE planMeal SET locked = ? WHERE weekStart = ? AND day = ? AND slot = ?;

-- Items ticked off on a week's shopping list.
CREATE TABLE shoppingCheck (
    weekStart TEXT NOT NULL,
    itemKey TEXT NOT NULL,
    PRIMARY KEY (weekStart, itemKey)
);

selectChecks:
SELECT itemKey FROM shoppingCheck WHERE weekStart = ?;

insertCheck:
INSERT OR IGNORE INTO shoppingCheck (weekStart, itemKey) VALUES (?, ?);

deleteCheck:
DELETE FROM shoppingCheck WHERE weekStart = ? AND itemKey = ?;
