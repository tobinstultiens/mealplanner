-- One planned meal. Nutrition is a snapshot taken when the meal was planned.
CREATE TABLE planMeal (
    userId INTEGER NOT NULL REFERENCES appUser(id) ON DELETE CASCADE,
    weekStart TEXT NOT NULL,           -- ISO date of the plan's first day
    day INTEGER NOT NULL,              -- 0-based offset from weekStart
    slot TEXT NOT NULL,                -- BREAKFAST | LUNCH | DINNER | SNACK
    recipeId INTEGER NOT NULL,
    title TEXT NOT NULL,
    portions REAL NOT NULL,
    kcal REAL NOT NULL,
    proteinG REAL NOT NULL,
    leftover INTEGER NOT NULL,
    locked INTEGER NOT NULL,
    status TEXT NOT NULL DEFAULT 'PLANNED',   -- PLANNED | EATEN | SKIPPED
    PRIMARY KEY (userId, weekStart, day, slot)
);

selectWeek:
SELECT * FROM planMeal WHERE userId = ? AND weekStart = ? ORDER BY day;

upsertMeal:
INSERT OR REPLACE INTO planMeal (userId, weekStart, day, slot, recipeId, title, portions, kcal, proteinG, leftover, locked, status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Where a recipe is planned in weeks that started after the given date (an ISO date).
selectPlannedFrom:
SELECT weekStart, day FROM planMeal WHERE userId = ? AND recipeId = ? AND weekStart > ? ORDER BY weekStart, day;

setStatus:
UPDATE planMeal SET status = ? WHERE userId = ? AND weekStart = ? AND day = ? AND slot = ?;

deleteMeal:
DELETE FROM planMeal WHERE userId = ? AND weekStart = ? AND day = ? AND slot = ?;

setLocked:
UPDATE planMeal SET locked = ? WHERE userId = ? AND weekStart = ? AND day = ? AND slot = ?;

-- What one meal ate that differs from its recipe (issue 226), one row per ingredient: grams is the amount
-- eaten of it in this meal, 0 for a recipe line left out. The recipe stays as it is. The rows go with their
-- meal, so replacing or removing the meal drops them, and with the ingredient when it leaves the catalogue.
CREATE TABLE mealLine (
    userId INTEGER NOT NULL,
    weekStart TEXT NOT NULL,
    day INTEGER NOT NULL,
    slot TEXT NOT NULL,
    ingredientId INTEGER NOT NULL REFERENCES ingredient(id) ON DELETE CASCADE,
    grams REAL NOT NULL,
    PRIMARY KEY (userId, weekStart, day, slot, ingredientId),
    FOREIGN KEY (userId, weekStart, day, slot) REFERENCES planMeal(userId, weekStart, day, slot) ON DELETE CASCADE
);

CREATE INDEX mealLine_ingredient ON mealLine(ingredientId);

selectMealLines:
SELECT ingredientId, grams FROM mealLine WHERE userId = :userId AND weekStart = :weekStart AND day = :day AND slot = :slot;

selectWeekLines:
SELECT day, slot, ingredientId, grams FROM mealLine WHERE userId = :userId AND weekStart = :weekStart;

insertMealLine:
INSERT INTO mealLine (userId, weekStart, day, slot, ingredientId, grams) VALUES (?, ?, ?, ?, ?, ?);

deleteMealLines:
DELETE FROM mealLine WHERE userId = :userId AND weekStart = :weekStart AND day = :day AND slot = :slot;

-- What the account's meals of one recipe had in them, in every week: where quick add-ons come from.
selectRecipeMealLines:
SELECT mealLine.ingredientId, mealLine.grams, mealLine.weekStart, mealLine.day, mealLine.slot
FROM mealLine
JOIN planMeal ON planMeal.userId = mealLine.userId AND planMeal.weekStart = mealLine.weekStart
    AND planMeal.day = mealLine.day AND planMeal.slot = mealLine.slot
WHERE mealLine.userId = :userId AND planMeal.recipeId = :recipeId AND mealLine.grams > 0;

-- A prepped batch (issue 234): one recipe cooked once, on madeOn, and eaten in the meals of prepPortion
-- until lastDay. Started by hand only. recipeId has no reference, as planMeal's has none: a meal stays
-- in the plan's history with its stored title when the recipe goes.
CREATE TABLE prep (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    userId INTEGER NOT NULL REFERENCES appUser(id) ON DELETE CASCADE,
    recipeId INTEGER NOT NULL,
    madeOn TEXT NOT NULL,              -- ISO date it is made; its first meal is that day
    lastDay TEXT NOT NULL,             -- ISO date of the last day it keeps, from the recipe's keeps when it was made
    vacuum INTEGER NOT NULL            -- 1: vacuum sealed
);

CREATE INDEX prep_user ON prep(userId, lastDay);

-- A meal's share of a prepped batch. role MEAL: the slot's meal is eaten from the batch, and portions is NULL
-- for the meal's own portions, or 0 once it was skipped and its share is eaten in another meal. role SIDE
-- (step 2): a side next to the slot's meal, which keeps its own main, of portions servings of the batch; it
-- shares the meal's status, and is moved when its share is eaten elsewhere, except the side the batch is made
-- with, which is kept at 0 as a meal is: the batch is still made on that day, with that meal.
-- A row goes with its meal, so removing the meal takes it out of the batch; replacing a meal's main keeps
-- its side (PlanRepository.save).
CREATE TABLE prepPortion (
    userId INTEGER NOT NULL,
    weekStart TEXT NOT NULL,
    day INTEGER NOT NULL,
    slot TEXT NOT NULL,
    role TEXT NOT NULL DEFAULT 'MEAL',
    prepId INTEGER NOT NULL REFERENCES prep(id) ON DELETE CASCADE,
    portions REAL,
    PRIMARY KEY (userId, weekStart, day, slot, role),
    FOREIGN KEY (userId, weekStart, day, slot) REFERENCES planMeal(userId, weekStart, day, slot) ON DELETE CASCADE
);

CREATE INDEX prepPortion_prep ON prepPortion(prepId);

insertPrep:
INSERT INTO prep (userId, recipeId, madeOn, lastDay, vacuum) VALUES (?, ?, ?, ?, ?);

lastPrepId:
SELECT last_insert_rowid();

-- A batch with its recipe's title, which a batch eaten only as sides has nowhere else; NULL once the recipe is gone.
selectPrep:
SELECT prep.*, recipe.title AS recipeTitle FROM prep LEFT JOIN recipe ON recipe.id = prep.recipeId AND recipe.userId = prep.userId
WHERE prep.userId = :userId AND prep.id = :id;

-- The account's batches still keeping on :date or later.
selectPrepsKeeping:
SELECT * FROM prep WHERE userId = :userId AND lastDay >= :date ORDER BY madeOn, id;

-- The account's batches whose last day is :lastDay.
selectPrepsEndingOn:
SELECT id FROM prep WHERE userId = :userId AND lastDay = :lastDay ORDER BY madeOn, id;

deletePrep:
DELETE FROM prep WHERE userId = :userId AND id = :id;

insertPrepPortion:
INSERT INTO prepPortion (userId, weekStart, day, slot, role, prepId, portions) VALUES (?, ?, ?, ?, 'MEAL', ?, NULL);

insertSidePortion:
INSERT INTO prepPortion (userId, weekStart, day, slot, role, prepId, portions) VALUES (?, ?, ?, ?, 'SIDE', ?, ?);

-- The side next to one meal, if it has one.
selectSidePortion:
SELECT prepId, portions FROM prepPortion
WHERE userId = :userId AND weekStart = :weekStart AND day = :day AND slot = :slot AND role = 'SIDE';

deleteSidePortion:
DELETE FROM prepPortion WHERE userId = :userId AND weekStart = :weekStart AND day = :day AND slot = :slot AND role = 'SIDE';

-- Which batch each meal of one week is eaten from.
selectWeekPrepIds:
SELECT day, slot, prepId FROM prepPortion WHERE userId = :userId AND weekStart = :weekStart AND role = 'MEAL';

-- Which batch the side next to each meal of one week is taken from.
selectWeekSides:
SELECT day, slot, prepId FROM prepPortion WHERE userId = :userId AND weekStart = :weekStart AND role = 'SIDE';

-- The meals and sides of batches, in every week, with their share; a side with the meal it is next to.
selectPrepMeals:
SELECT prepPortion.prepId, prepPortion.role, prepPortion.portions AS share, planMeal.*
FROM prepPortion
JOIN planMeal ON planMeal.userId = prepPortion.userId AND planMeal.weekStart = prepPortion.weekStart
    AND planMeal.day = prepPortion.day AND planMeal.slot = prepPortion.slot
WHERE prepPortion.userId = :userId AND prepPortion.prepId IN :prepIds;

-- Where a recipe is eaten as a side in weeks that started after the given date (an ISO date), as selectPlannedFrom.
selectSidesPlannedFrom:
SELECT prepPortion.weekStart, prepPortion.day FROM prepPortion JOIN prep ON prep.id = prepPortion.prepId
WHERE prep.userId = :userId AND prep.recipeId = :recipeId AND prepPortion.role = 'SIDE' AND prepPortion.weekStart > :after;

-- The skipped meal's share is eaten in another meal.
clearPrepShare:
UPDATE prepPortion SET portions = 0
WHERE userId = :userId AND weekStart = :weekStart AND day = :day AND slot = :slot AND role = 'MEAL';

-- The skipped side the batch is made with is eaten next to another meal: it stays, at 0, as where the batch is made.
clearSideShare:
UPDATE prepPortion SET portions = 0
WHERE userId = :userId AND weekStart = :weekStart AND day = :day AND slot = :slot AND role = 'SIDE';

-- What a meal (or the side next to it, by role) took from the stock and what was in it go with its share to
-- another meal of the batch.
moveStockUses:
UPDATE stockUse SET weekStart = :toWeek, day = :toDay, slot = :toSlot
WHERE userId = :userId AND weekStart = :weekStart AND day = :day AND slot = :slot AND role = :role;

moveMealLines:
UPDATE mealLine SET weekStart = :toWeek, day = :toDay, slot = :toSlot
WHERE userId = :userId AND weekStart = :weekStart AND day = :day AND slot = :slot;

-- The latest offers per store, replaced as a whole by each successful fetch.
CREATE TABLE offer (
    store TEXT NOT NULL,
    title TEXT NOT NULL,
    deal TEXT,
    price REAL,
    originalPrice REAL,
    packSize TEXT,
    category TEXT,
    validFrom TEXT NOT NULL,
    validUntil TEXT NOT NULL,
    url TEXT,
    imageUrl TEXT                      -- the store's product picture, on one of its image hosts
);

CREATE INDEX offer_store ON offer(store);

CREATE TABLE offerSource (
    store TEXT PRIMARY KEY,
    fetchedAt TEXT,
    error TEXT
);

selectOffersValidOn:
SELECT * FROM offer WHERE validFrom <= :date AND validUntil >= :date ORDER BY store, title;

-- Offers valid on at least one day between :from and :until.
selectOffersOverlapping:
SELECT * FROM offer WHERE validFrom <= :until AND validUntil >= :from ORDER BY store, title;

countOffers:
SELECT store, count(*) AS n FROM offer GROUP BY store;

deleteOffers:
DELETE FROM offer WHERE store = ?;

insertOffer:
INSERT INTO offer (store, title, deal, price, originalPrice, packSize, category, validFrom, validUntil, url, imageUrl)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectSources:
SELECT * FROM offerSource;

ensureSource:
INSERT OR IGNORE INTO offerSource (store) VALUES (?);

recordSuccess:
UPDATE offerSource SET fetchedAt = ?, error = NULL WHERE store = ?;

recordFailure:
UPDATE offerSource SET error = ? WHERE store = ?;
