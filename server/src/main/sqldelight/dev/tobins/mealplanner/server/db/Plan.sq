-- One planned meal. Nutrition is a snapshot taken when the meal was planned.
CREATE TABLE planMeal (
    userId INTEGER NOT NULL REFERENCES appUser(id) ON DELETE CASCADE,
    weekStart TEXT NOT NULL,           -- ISO date of the plan's first day
    day INTEGER NOT NULL,              -- 0-based offset from weekStart
    slot TEXT NOT NULL,                -- BREAKFAST | LUNCH | DINNER | SNACK
    recipeId INTEGER NOT NULL,
    title TEXT NOT NULL,
    portions REAL NOT NULL,
    kcal REAL NOT NULL,
    proteinG REAL NOT NULL,
    leftover INTEGER NOT NULL,
    locked INTEGER NOT NULL,
    status TEXT NOT NULL DEFAULT 'PLANNED',   -- PLANNED | EATEN | SKIPPED
    PRIMARY KEY (userId, weekStart, day, slot)
);

selectWeek:
SELECT * FROM planMeal WHERE userId = ? AND weekStart = ? ORDER BY day;

upsertMeal:
INSERT OR REPLACE INTO planMeal (userId, weekStart, day, slot, recipeId, title, portions, kcal, proteinG, leftover, locked, status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Replanning leaves alone what is locked or already eaten or skipped.
deleteUnlocked:
DELETE FROM planMeal WHERE userId = ? AND weekStart = ? AND locked = 0 AND status = 'PLANNED';

setStatus:
UPDATE planMeal SET status = ? WHERE userId = ? AND weekStart = ? AND day = ? AND slot = ?;

deleteMeal:
DELETE FROM planMeal WHERE userId = ? AND weekStart = ? AND day = ? AND slot = ?;

setLocked:
UPDATE planMeal SET locked = ? WHERE userId = ? AND weekStart = ? AND day = ? AND slot = ?;

-- Items ticked off on a week's shopping list.
CREATE TABLE shoppingCheck (
    userId INTEGER NOT NULL REFERENCES appUser(id) ON DELETE CASCADE,
    weekStart TEXT NOT NULL,
    itemKey TEXT NOT NULL,
    PRIMARY KEY (userId, weekStart, itemKey)
);

selectChecks:
SELECT itemKey FROM shoppingCheck WHERE userId = ? AND weekStart = ?;

insertCheck:
INSERT OR IGNORE INTO shoppingCheck (userId, weekStart, itemKey) VALUES (?, ?, ?);

deleteCheck:
DELETE FROM shoppingCheck WHERE userId = ? AND weekStart = ? AND itemKey = ?;

-- The latest offers per store, replaced as a whole by each successful fetch.
CREATE TABLE offer (
    store TEXT NOT NULL,
    title TEXT NOT NULL,
    deal TEXT,
    price REAL,
    originalPrice REAL,
    packSize TEXT,
    category TEXT,
    validFrom TEXT NOT NULL,
    validUntil TEXT NOT NULL,
    url TEXT
);

CREATE INDEX offer_store ON offer(store);

CREATE TABLE offerSource (
    store TEXT PRIMARY KEY,
    fetchedAt TEXT,
    error TEXT
);

selectOffersValidOn:
SELECT * FROM offer WHERE validFrom <= :date AND validUntil >= :date ORDER BY store, title;

-- Offers valid on at least one day between :from and :until.
selectOffersOverlapping:
SELECT * FROM offer WHERE validFrom <= :until AND validUntil >= :from ORDER BY store, title;

countOffers:
SELECT store, count(*) AS n FROM offer GROUP BY store;

deleteOffers:
DELETE FROM offer WHERE store = ?;

insertOffer:
INSERT INTO offer (store, title, deal, price, originalPrice, packSize, category, validFrom, validUntil, url)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectSources:
SELECT * FROM offerSource;

ensureSource:
INSERT OR IGNORE INTO offerSource (store) VALUES (?);

recordSuccess:
UPDATE offerSource SET fetchedAt = ?, error = NULL WHERE store = ?;

recordFailure:
UPDATE offerSource SET error = ? WHERE store = ?;
