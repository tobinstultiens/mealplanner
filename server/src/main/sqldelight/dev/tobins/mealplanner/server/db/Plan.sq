-- One planned meal. Nutrition is a snapshot taken when the meal was planned.
CREATE TABLE planMeal (
    userId INTEGER NOT NULL REFERENCES appUser(id) ON DELETE CASCADE,
    weekStart TEXT NOT NULL,           -- ISO date of the plan's first day
    day INTEGER NOT NULL,              -- 0-based offset from weekStart
    slot TEXT NOT NULL,                -- BREAKFAST | LUNCH | DINNER | SNACK
    recipeId INTEGER NOT NULL,
    title TEXT NOT NULL,
    portions REAL NOT NULL,
    kcal REAL NOT NULL,
    proteinG REAL NOT NULL,
    leftover INTEGER NOT NULL,
    locked INTEGER NOT NULL,
    status TEXT NOT NULL DEFAULT 'PLANNED',   -- PLANNED | EATEN | SKIPPED
    PRIMARY KEY (userId, weekStart, day, slot)
);

selectWeek:
SELECT * FROM planMeal WHERE userId = ? AND weekStart = ? ORDER BY day;

upsertMeal:
INSERT OR REPLACE INTO planMeal (userId, weekStart, day, slot, recipeId, title, portions, kcal, proteinG, leftover, locked, status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Where a recipe is planned in weeks that started after the given date (an ISO date).
selectPlannedFrom:
SELECT weekStart, day FROM planMeal WHERE userId = ? AND recipeId = ? AND weekStart > ? ORDER BY weekStart, day;

setStatus:
UPDATE planMeal SET status = ? WHERE userId = ? AND weekStart = ? AND day = ? AND slot = ?;

deleteMeal:
DELETE FROM planMeal WHERE userId = ? AND weekStart = ? AND day = ? AND slot = ?;

setLocked:
UPDATE planMeal SET locked = ? WHERE userId = ? AND weekStart = ? AND day = ? AND slot = ?;

-- What one meal ate that differs from its recipe (issue 226), one row per ingredient: grams is the amount
-- eaten of it in this meal, 0 for a recipe line left out. The recipe stays as it is. The rows go with their
-- meal, so replacing or removing the meal drops them, and with the ingredient when it leaves the catalogue.
CREATE TABLE mealLine (
    userId INTEGER NOT NULL,
    weekStart TEXT NOT NULL,
    day INTEGER NOT NULL,
    slot TEXT NOT NULL,
    ingredientId INTEGER NOT NULL REFERENCES ingredient(id) ON DELETE CASCADE,
    grams REAL NOT NULL,
    PRIMARY KEY (userId, weekStart, day, slot, ingredientId),
    FOREIGN KEY (userId, weekStart, day, slot) REFERENCES planMeal(userId, weekStart, day, slot) ON DELETE CASCADE
);

CREATE INDEX mealLine_ingredient ON mealLine(ingredientId);

selectMealLines:
SELECT ingredientId, grams FROM mealLine WHERE userId = :userId AND weekStart = :weekStart AND day = :day AND slot = :slot;

selectWeekLines:
SELECT day, slot, ingredientId, grams FROM mealLine WHERE userId = :userId AND weekStart = :weekStart;

insertMealLine:
INSERT INTO mealLine (userId, weekStart, day, slot, ingredientId, grams) VALUES (?, ?, ?, ?, ?, ?);

deleteMealLines:
DELETE FROM mealLine WHERE userId = :userId AND weekStart = :weekStart AND day = :day AND slot = :slot;

-- What the account's meals of one recipe had in them, in every week: where quick add-ons come from.
selectRecipeMealLines:
SELECT mealLine.ingredientId, mealLine.grams, mealLine.weekStart, mealLine.day, mealLine.slot
FROM mealLine
JOIN planMeal ON planMeal.userId = mealLine.userId AND planMeal.weekStart = mealLine.weekStart
    AND planMeal.day = mealLine.day AND planMeal.slot = mealLine.slot
WHERE mealLine.userId = :userId AND planMeal.recipeId = :recipeId AND mealLine.grams > 0;

-- The latest offers per store, replaced as a whole by each successful fetch.
CREATE TABLE offer (
    store TEXT NOT NULL,
    title TEXT NOT NULL,
    deal TEXT,
    price REAL,
    originalPrice REAL,
    packSize TEXT,
    category TEXT,
    validFrom TEXT NOT NULL,
    validUntil TEXT NOT NULL,
    url TEXT,
    imageUrl TEXT                      -- the store's product picture, on one of its image hosts
);

CREATE INDEX offer_store ON offer(store);

CREATE TABLE offerSource (
    store TEXT PRIMARY KEY,
    fetchedAt TEXT,
    error TEXT
);

selectOffersValidOn:
SELECT * FROM offer WHERE validFrom <= :date AND validUntil >= :date ORDER BY store, title;

-- Offers valid on at least one day between :from and :until.
selectOffersOverlapping:
SELECT * FROM offer WHERE validFrom <= :until AND validUntil >= :from ORDER BY store, title;

countOffers:
SELECT store, count(*) AS n FROM offer GROUP BY store;

deleteOffers:
DELETE FROM offer WHERE store = ?;

insertOffer:
INSERT INTO offer (store, title, deal, price, originalPrice, packSize, category, validFrom, validUntil, url, imageUrl)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectSources:
SELECT * FROM offerSource;

ensureSource:
INSERT OR IGNORE INTO offerSource (store) VALUES (?);

recordSuccess:
UPDATE offerSource SET fetchedAt = ?, error = NULL WHERE store = ?;

recordFailure:
UPDATE offerSource SET error = ? WHERE store = ?;
