-- Each account's ingredient catalogue. An ingredient points at a NEVO food for its
-- nutrition (nevoCode is not a foreign key: the food table is replaced on re-import).
CREATE TABLE ingredient (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    userId INTEGER NOT NULL REFERENCES appUser(id) ON DELETE CASCADE,
    name TEXT NOT NULL COLLATE NOCASE,
    nevoCode INTEGER,
    gramsPerPiece REAL,                -- weight of one piece/clove/can, for count lines
    gramsPerMl REAL,                   -- density, for volume lines
    category TEXT,
    pricePerKg REAL,
    isStaple INTEGER NOT NULL DEFAULT 0,
    negligible INTEGER NOT NULL DEFAULT 0,  -- herbs, spices, leaveners: left out of nutrition
    UNIQUE (userId, name)
);

-- Remembers which ingredient a recipe line's text means. Keyed by the normalised
-- text, so one confirmation covers every recipe of the account and survives re-syncs.
CREATE TABLE ingredientAlias (
    userId INTEGER NOT NULL REFERENCES appUser(id) ON DELETE CASCADE,
    text TEXT NOT NULL,
    ingredientId INTEGER NOT NULL REFERENCES ingredient(id) ON DELETE CASCADE,
    PRIMARY KEY (userId, text)
);

selectAllIngredients:
SELECT * FROM ingredient WHERE userId = ? ORDER BY name COLLATE NOCASE;

selectIngredient:
SELECT * FROM ingredient WHERE userId = ? AND id = ?;

selectIngredientByNevoCode:
SELECT * FROM ingredient WHERE userId = ? AND nevoCode = ? ORDER BY id LIMIT 1;

selectIngredientByName:
SELECT * FROM ingredient WHERE userId = ? AND name = ?;

insertIngredient:
INSERT INTO ingredient (userId, name, nevoCode, gramsPerPiece, gramsPerMl, category, pricePerKg, isStaple, negligible)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

lastIngredientId:
SELECT last_insert_rowid();

updateIngredient:
UPDATE ingredient
SET name = ?, nevoCode = ?, gramsPerPiece = ?, gramsPerMl = ?, category = ?, pricePerKg = ?, isStaple = ?, negligible = ?
WHERE userId = ? AND id = ?;

selectAliases:
SELECT * FROM ingredientAlias WHERE userId = ?;

upsertAlias:
INSERT OR REPLACE INTO ingredientAlias (userId, text, ingredientId) VALUES (?, ?, ?);

insertAliasIfAbsent:
INSERT OR IGNORE INTO ingredientAlias (userId, text, ingredientId) VALUES (?, ?, ?);

deleteAlias:
DELETE FROM ingredientAlias WHERE userId = ? AND text = ?;

-- Every ingredient line of the account's active recipes, for finding unmapped texts.
selectActiveLines:
SELECT ri.amount, ri.unit, ri.dimension, ri.baseAmount, ri.item, ri.groupName, r.title
FROM recipeIngredient ri JOIN recipe r ON r.id = ri.recipeId
WHERE r.userId = ? AND r.removedAt IS NULL;

-- All accounts at once, for the shared price lookup.
selectEveryIngredient:
SELECT * FROM ingredient ORDER BY id;

selectEveryAlias:
SELECT * FROM ingredientAlias;
