-- Regular store prices, shared by every account: keyed by ingredient name, so each
-- account's catalogue finds the price for its own ingredient of that name. Replaced
-- per name by each lookup.
CREATE TABLE ingredientPrice (
    name TEXT NOT NULL PRIMARY KEY COLLATE NOCASE,
    store TEXT NOT NULL,
    product TEXT NOT NULL,
    packSize TEXT,
    packPrice REAL,
    eurosPerKg REAL NOT NULL,
    fetchedAt TEXT NOT NULL
);

selectPrices:
SELECT * FROM ingredientPrice ORDER BY name COLLATE NOCASE;

upsertPrice:
INSERT OR REPLACE INTO ingredientPrice (name, store, product, packSize, packPrice, eurosPerKg, fetchedAt)
VALUES (?, ?, ?, ?, ?, ?, ?);

deletePrice:
DELETE FROM ingredientPrice WHERE name = ?;
