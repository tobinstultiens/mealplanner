-- Perishables currently at home that should be used up, of an account through the ingredient. Two kinds:
-- put on hand by hand (onHand), which says only that it is there, until removed by hand; and the stock
-- the shopping list put there (stock), which meals eat from. An ingredient is one or the other: marked on
-- hand by hand, its stock goes and ticks add none, as the owner says what is at home.
CREATE TABLE onHand (
    ingredientId INTEGER PRIMARY KEY REFERENCES ingredient(id) ON DELETE CASCADE,
    addedAt TEXT NOT NULL
);

-- The stock, one entry for each thing that put some there (issue 116), so that taking one back takes
-- back only what it put there, whatever meals ate or gave back in between. On hand from fromWeek on:
-- meals of that week or later that use it are eaten from it, the oldest entry first; grams is what is
-- left of what was bought, and the entry goes once it is used up. With grams NULL (weight unknown, or
-- ticked before version 9) the first such meal uses it up. What each meal took is kept in stockUse.
CREATE TABLE stock (
    ingredientId INTEGER NOT NULL REFERENCES ingredient(id) ON DELETE CASCADE,
    fromWeek TEXT NOT NULL,            -- ISO date of the plan week it counts from
    source TEXT NOT NULL,              -- STOCK_UP | BUY_AHEAD | USE_UP (StockSource)
    addedAt TEXT NOT NULL,
    grams REAL,
    PRIMARY KEY (ingredientId, fromWeek, source)
);

-- The pantry's list: what is on hand by hand or in stock (next week's too), in the order it came.
selectOnHand:
SELECT o.ingredientId FROM (
    SELECT ingredientId, addedAt FROM onHand
    UNION ALL
    SELECT ingredientId, addedAt FROM stock
) o JOIN ingredient i ON i.id = o.ingredientId
WHERE i.userId = ?
GROUP BY o.ingredientId
ORDER BY min(o.addedAt), o.ingredientId;

-- Every statement that changes onHand or stock names the account: an ingredient of another one changes nothing.

-- Put on hand by hand. An ingredient in stock keeps its place in the pantry's list (the stock then goes: deleteStockOf).
insertOnHand:
INSERT OR IGNORE INTO onHand (ingredientId, addedAt)
SELECT id, coalesce((SELECT min(addedAt) FROM stock WHERE ingredientId = :id), :addedAt) FROM ingredient WHERE id = :id AND userId = :userId;

deleteOnHand:
DELETE FROM onHand WHERE ingredientId = :id AND ingredientId IN (SELECT id FROM ingredient WHERE userId = :userId);

selectOnHandByHand:
SELECT o.ingredientId FROM onHand o JOIN ingredient i ON i.id = o.ingredientId WHERE i.userId = ?;

-- Every entry of the account's stock, with the week it counts from and the grams left of it (NULL: not known).
selectStockOfAccount:
SELECT s.ingredientId, s.fromWeek, s.grams FROM stock s JOIN ingredient i ON i.id = s.ingredientId
WHERE i.userId = ?;

-- What a meal of :week that uses these ingredients is eaten from: what counts from that week or before, oldest first.
selectStock:
SELECT s.ingredientId, s.fromWeek, s.source, s.addedAt, s.grams FROM stock s JOIN ingredient i ON i.id = s.ingredientId
WHERE i.userId = :userId AND s.fromWeek <= :week AND s.ingredientId IN :ids
ORDER BY s.ingredientId, s.fromWeek, s.addedAt, s.source;

-- A ticked item of the shopping list, or a used-up entry a meal un-eaten puts back as it was. An entry of
-- the same source and week there already stays as it is (ticking a ticked item again), and an ingredient
-- on hand by hand gets none.
insertStock:
INSERT OR IGNORE INTO stock (ingredientId, fromWeek, source, addedAt, grams)
SELECT id, :fromWeek, :source, :addedAt, :grams FROM ingredient
WHERE id = :id AND userId = :userId AND id NOT IN (SELECT ingredientId FROM onHand);

-- Grams added to an entry that is there: what a meal un-eaten took from it, or more of an item used up.
-- An amount unknown on either side makes the total unknown.
addToStock:
UPDATE stock SET grams = grams + :grams
WHERE ingredientId = :id AND fromWeek = :fromWeek AND source = :source AND ingredientId IN (SELECT id FROM ingredient WHERE userId = :userId);

-- What is left of an entry after a meal was eaten from it.
setStockGrams:
UPDATE stock SET grams = :grams
WHERE ingredientId = :id AND fromWeek = :fromWeek AND source = :source AND ingredientId IN (SELECT id FROM ingredient WHERE userId = :userId);

-- The entry goes: un-ticked (it was not bought), or a meal used it up.
deleteStock:
DELETE FROM stock
WHERE ingredientId = :id AND fromWeek = :fromWeek AND source = :source AND ingredientId IN (SELECT id FROM ingredient WHERE userId = :userId);

-- Put on hand or taken off by hand: the owner says what is at home.
deleteStockOf:
DELETE FROM stock WHERE ingredientId = :id AND ingredientId IN (SELECT id FROM ingredient WHERE userId = :userId);

-- What eating a meal took from one entry of the stock (issue 84), kept under the meal whose portions it
-- was for, so that un-eating the meal puts exactly that back, into the entry it came from. A dinner is
-- cooked with its leftovers: what it took for the next day's leftover lunch is kept under that lunch.
-- The rows go with their meal, so a meal that has some is neither replaced nor removed (PlanRepository.whyKeepsItsRecipe).
CREATE TABLE stockUse (
    userId INTEGER NOT NULL,
    weekStart TEXT NOT NULL,
    day INTEGER NOT NULL,
    slot TEXT NOT NULL,
    ingredientId INTEGER NOT NULL REFERENCES ingredient(id) ON DELETE CASCADE,
    fromWeek TEXT NOT NULL,            -- stock.fromWeek of the entry it was taken from
    source TEXT NOT NULL,              -- stock.source of that entry
    addedAt TEXT NOT NULL,             -- stock.addedAt of that entry
    grams REAL,                        -- taken; NULL when the entry's amount was unknown and the meal used it up
    PRIMARY KEY (userId, weekStart, day, slot, ingredientId, fromWeek, source),
    FOREIGN KEY (userId, weekStart, day, slot) REFERENCES planMeal(userId, weekStart, day, slot) ON DELETE CASCADE
);

CREATE INDEX stockUse_ingredient ON stockUse(ingredientId);

selectStockUses:
SELECT ingredientId, fromWeek, source, addedAt, grams FROM stockUse
WHERE userId = :userId AND weekStart = :weekStart AND day = :day AND slot = :slot;

-- What the meals of one week took from the stock, by ingredient.
selectWeekStockUses:
SELECT ingredientId, grams FROM stockUse WHERE userId = :userId AND weekStart = :weekStart;

insertStockUse:
INSERT INTO stockUse (userId, weekStart, day, slot, ingredientId, fromWeek, source, addedAt, grams) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteStockUses:
DELETE FROM stockUse WHERE userId = :userId AND weekStart = :weekStart AND day = :day AND slot = :slot;

-- A meal adjusted after its share was taken (issue 226): what it took of one ingredient was put back.
deleteStockUsesOfMeal:
DELETE FROM stockUse WHERE userId = :userId AND weekStart = :weekStart AND day = :day AND slot = :slot AND ingredientId = :id;

-- The entry was declared not bought (un-ticked): what meals took from it is not given back either.
deleteStockUsesFrom:
DELETE FROM stockUse WHERE userId = :userId AND ingredientId = :id AND fromWeek = :fromWeek AND source = :source;

-- The ingredient was put on hand or taken off by hand: from then on the owner says what is at home.
deleteStockUsesOf:
DELETE FROM stockUse WHERE userId = :userId AND ingredientId = :id;

setStaple:
UPDATE ingredient SET isStaple = ? WHERE userId = ? AND id = ?;
